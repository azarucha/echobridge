# echobridge configuration. The installer copies this to /etc/echobridge/echobridge.env.
# After changes: sudo systemctl restart echobridge

# LAN address of this machine (used for the Amazon login page and by the Fire TV)
HOST_IP=192.168.1.10

# AirPlay receivers: "Name=<Echo serial>", rooms separated by ";", several Echos with ",".
# The names appear in the iPhone's AirPlay menu. Find serials with: echobridge devices
ROOMS=Kitchen=G000000000000000;Living room=G000000000000001;Everywhere=G000000000000000,G000000000000001

# Who plays a room (optional, default: the skill on the room's Echos). Combine with "+":
#   skill | skill:<serial> | firetv:<ip>
# Room ids are the names in lower case with dashes ("Living room" -> living-room).
# Example: living room in stereo through a Fire TV home theater, "Everywhere" on Fire TV plus the kitchen Echo
#PLAYERS=living-room=firetv:192.168.1.50;everywhere=firetv:192.168.1.50+skill:G000000000000000

# The custom Alexa skill (docs/alexa-skill.md)
PUBLIC_URL=https://echobridge.example.com
SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
SKILL_INVOCATION=my sound bridge

# Amazon region: amazon.de, amazon.co.uk or amazon.com (sets API host, language and "open"/"öffne")
AMAZON_PAGE=amazon.com
#ALEXA_SERVICE_HOST=pitangui.amazon.com
#ALEXA_LANGUAGE=en-US
#SKILL_OPEN_WORD=open

# Optional
#DATA_DIR=/var/lib/echobridge
#ECHO_VOLUME_STEP=4
#STREAM_BITRATE=192k
#CONTROL_PORT=8095
#HOOK_PORT=8097
#SKILL_PORT=8098
#LOGIN_PORT=3456
#SHAIRPORT_BIN=shairport-sync
#DEBUG=1
